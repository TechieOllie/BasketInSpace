{
  "name": "basketinspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "build:api": "tsc -p tsconfig.server.json",
    "lint": "eslint .",
